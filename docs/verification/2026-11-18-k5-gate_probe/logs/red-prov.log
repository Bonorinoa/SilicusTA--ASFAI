/* ---- AI check (wizard step and the studio's AI status) ---- */
.check { display: flex; flex-direction: column; gap: 14px; }
.diagnosis { display: grid; grid-template-columns: 14px minmax(0, 1fr); gap: 4px 12px; align-items: baseline; }
.dot { width: 10px; height: 10px; border-radius: 999px; background: var(--fn-line-dash); transform: translateY(1px); }
.dot[data-tone=\"ok\"] { background: var(--fn-done); }
