.ticks span:nth-child(4) { left: 54.3%; } .ticks span:nth-child(5) { left: 71.7%; } .ticks span:nth-child(6) { left: 97.8%; }
.stripCaption { font-size: 0.8125rem; color: var(--fn-ink-soft); font-variant-numeric: tabular-nums; }

.ways { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
