/* ---- step 1 (G2b): learners, the skill-map strip, topic two ways, consequences ---- */
.learners, .topicWays { border: 0; margin: 0; padding: 0; min-width: 0; display: flex; flex-direction: column; gap: 10px; }
.learners > legend, .topicWays > legend { padding: 0; margin-bottom: 10px; }
.groups { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
.group {
