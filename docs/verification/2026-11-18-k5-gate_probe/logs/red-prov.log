/* ---- sources ---- */
.dropArea { display: flex; flex-direction: column; gap: 16px; }
.drop {
  display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 22px 22px 20px;
  border: 1.5px dashed var(--fn-line-dash); border-radius: 12px; background: #fffdf8;
  transition: background 160ms var(--fn-ease), border-color 160ms var(--fn-ease);
