.consequences { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border: 1px solid var(--fn-line); border-radius: 10px; overflow: hidden; background: var(--fn-desk); }
.tile { display: flex; flex-direction: column; gap: 4px; padding: 12px 14px; min-width: 0; }
