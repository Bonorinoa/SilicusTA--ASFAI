.bar[data-on=\"true\"] { background: var(--fn-accent); }
.ticks { position: relative; height: 14px; font-size: 0.6875rem; color: var(--fn-ink-muted); font-variant-numeric: tabular-nums; }
.ticks span { position: absolute; transform: translateX(-50%); }
